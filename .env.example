# Copy this file to .env and fill in real values. NEVER commit .env.

# Database connection string. SQLite default is used when unset.
# For PostgreSQL in deployment:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/assistant
DATABASE_URL=

# API keys are added when we integrate an LLM (Phase 7).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
